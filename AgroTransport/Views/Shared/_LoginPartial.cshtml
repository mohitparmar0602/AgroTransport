@using Microsoft.AspNetCore.Identity
@using AgroTransport.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var role = user?.UserRole ?? (User.IsInRole("Administrator") ? "Administrator" : User.IsInRole("Transporter") ? "Transporter" : "Farmer");
    var dashboardUrl = role == "Administrator" ? "/Admin" : role == "Transporter" ? "/Transporter" : "/Farmer";
    var badgeClass = role == "Administrator" ? "bg-danger" : role == "Transporter" ? "bg-primary" : "bg-success";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1 px-3 rounded-pill bg-white bg-opacity-10 text-white border border-white border-opacity-25" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar-circle">
                @(user?.FullName?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <div class="d-none d-md-block text-start">
                <span class="fw-semibold text-white small d-block line-height-1">@user?.FullName</span>
                <span class="badge @badgeClass" style="font-size: 0.65rem;">@role</span>
            </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userDropdown">
            <li class="px-3 py-2 border-bottom">
                <p class="mb-0 fw-bold small text-dark">@user?.FullName</p>
                <small class="text-muted">@user?.Email</small>
            </li>
            <li>
                <a class="dropdown-item py-2" href="@dashboardUrl">
                    <i class="bi bi-speedometer2 me-2 text-success"></i> My Dashboard
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person-gear me-2 text-primary"></i> Profile Settings
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Notifications" asp-action="Index">
                    <i class="bi bi-bell me-2 text-warning"></i> Notifications
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline px-2" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger rounded-2 py-2">
                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-1" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right text-warning"></i> Sign In
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-agro-primary btn-sm px-3 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-1" asp-controller="Account" asp-action="Register">
            Get Started <i class="bi bi-arrow-right"></i>
        </a>
    </li>
}
</ul>
