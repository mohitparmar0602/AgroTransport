<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroTransport | Agricultural Produce Transportation & Pooling</title>
    
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Main Navigation Bar (Commercial Freight Header) -->
    <header class="sticky-top at-navbar shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark py-3">
            <div class="container">
                <a class="navbar-brand at-brand" asp-controller="Home" asp-action="Index">
                    <span class="at-brand-icon">
                        <i class="bi bi-truck-front-fill"></i>
                    </span>
                    <span>Agro<span class="at-brand-accent">Transport</span></span>
                </a>
                
                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link at-nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link at-nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link at-nav-link" asp-controller="Home" asp-action="HowItWorks">How It Works</a>
                        </li>
                        
                        <!-- Role-Specific Shortcuts for Signed In Users -->
                        @if (User.IsInRole("Farmer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success fw-bold ms-lg-2" asp-controller="Farmer" asp-action="Index">
                                    <i class="bi bi-person-badge me-1"></i> Farmer Portal
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Transporter"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold ms-lg-2" asp-controller="Transporter" asp-action="Index">
                                    <i class="bi bi-speedometer me-1"></i> Transporter Hub
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold ms-lg-2" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-check me-1"></i> Admin Console
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Content -->
    <main role="main" class="flex-grow-1">
        @if (ViewData["IsFullWidth"] != null && (bool)ViewData["IsFullWidth"]!)
        {
            <div class="container mt-3">
                <partial name="_AlertPartial" />
            </div>
            @RenderBody()
        }
        else
        {
            <div class="container py-4">
                <partial name="_AlertPartial" />
                @RenderBody()
            </div>
        }
    </main>

    <!-- Discreet Academic / University Project Footer -->
    <footer class="border-top py-3 text-center small text-muted bg-white mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                <span class="fw-bold text-dark"><i class="bi bi-truck-front-fill text-warning me-1"></i>AgroTransport</span> &bull; Smart India Hackathon PR424 &bull; INT402 Modern Web Programming
            </div>
            <div>
                &copy; @DateTime.Now.Year AgroTransport Platform. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
