@{
    ViewData["Title"] = "Contact Support & Mandi Logistics Hub";
}

<div class="dash-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-headset me-1"></i> Support & Assistance
            </span>
            <h2 class="fw-bold mb-1">Contact AgroTransport</h2>
            <p class="text-white-50 mb-0">We are here to assist farmers, transporters, and Mandi market coordinators 24/7.</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="dash-card p-4 h-100">
            <h4 class="fw-bold mb-3">Mandi Logistics Assistance</h4>
            <p class="text-muted small mb-4">
                Have a question regarding vehicle pooling, scheduled departures, or payment sharing? Reach out to our regional dispatch coordinators.
            </p>

            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="dash-stat-icon orange" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Regional Headquarters</h6>
                    <small class="text-muted">Mandi Freight Logistics Hub, GT Road, Phagwara, Punjab 144401</small>
                </div>
            </div>

            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="dash-stat-icon emerald" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-telephone-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Toll-Free Helpline</h6>
                    <small class="text-muted">+91 1800-AGRO-POOL (1800 2476 7665)</small>
                </div>
            </div>

            <div class="d-flex align-items-start gap-3 mb-4">
                <div class="dash-stat-icon navy" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Email Support</h6>
                    <small class="text-muted">support@agrotransport.in / dispatch@agrotransport.in</small>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 border">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-success">Quick Tip</span>
                    <strong class="small">Immediate Trip Assistance</strong>
                </div>
                <small class="text-muted">For urgent departure inquiries on active trips, please call directly via the phone number shown on your booking confirmation voucher.</small>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="dash-card p-4 h-100">
            <h4 class="fw-bold mb-3">Send a Message</h4>
            <p class="text-muted small mb-4">Fill out the inquiry form below and our team will get back to you within 2 working hours.</p>

            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Full Name</label>
                        <input type="text" class="form-control" placeholder="Enter your full name" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Phone Number</label>
                        <input type="tel" class="form-control" placeholder="+91 98765 43210" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Email Address</label>
                        <input type="email" class="form-control" placeholder="name@example.com" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">I am a...</label>
                        <select class="form-select">
                            <option value="Farmer">Farmer (Produce Transportation)</option>
                            <option value="Transporter">Transporter / Vehicle Owner</option>
                            <option value="MandiOfficial">Mandi Official / Agent</option>
                            <option value="Other">Other Inquiry</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Subject</label>
                        <input type="text" class="form-control" placeholder="Brief subject of your message" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Message Details</label>
                        <textarea class="form-control" rows="4" placeholder="How can our logistics team assist you?" required></textarea>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn-freight-primary px-4" onclick="alert('Thank you! Your message has been received. Our team will contact you shortly.')">
                            <i class="bi bi-send-fill"></i> Send Message
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

