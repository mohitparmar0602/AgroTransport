@{
    ViewData["Title"] = "About AgroTransport — Together We Move Agriculture Forward";
}

<div class="dash-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-info-circle-fill me-1"></i> Platform Mission & Architecture
            </span>
            <h2 class="fw-bold mb-1">About AgroTransport</h2>
            <p class="text-white-50 mb-0">Agricultural Produce Transportation Sharing and Pooling Platform (SIH PR424).</p>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="dash-card p-4 h-100">
            <h4 class="fw-bold mb-3">Our Mission</h4>
            <p class="text-muted leading-relaxed">
                <strong>AgroTransport</strong> is an agricultural logistics marketplace engineered to solve one of the most persistent bottlenecks facing Indian farmers: the prohibitively high cost of transporting produce from rural farm gates to APMC wholesale mandis.
            </p>
            <p class="text-muted leading-relaxed mb-4">
                By enabling transparent capacity pooling, small and marginal farmers can reserve fractional truck space at proportional rates, while vehicle operators maximize payload capacity and eliminate empty return trips.
            </p>

            <h5 class="fw-bold mb-3">Key Platform Capabilities</h5>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-diagram-3-fill text-warning fs-5"></i>
                            <h6 class="fw-bold mb-0">Fractional Pooling</h6>
                        </div>
                        <small class="text-muted">Proportional fare allocation ensures smallholders pay strictly for their produce weight.</small>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-truck-front-fill text-success fs-5"></i>
                            <h6 class="fw-bold mb-0">Fleet Optimization</h6>
                        </div>
                        <small class="text-muted">Transporters aggregate multiple consignments along highway corridors to increase route revenues.</small>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-shield-check text-primary fs-5"></i>
                            <h6 class="fw-bold mb-0">Verified Logistics</h6>
                        </div>
                        <small class="text-muted">Role-based authentication guarantees driver verification and secure booking trails.</small>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-clock-history text-danger fs-5"></i>
                            <h6 class="fw-bold mb-0">Timely Dispatch</h6>
                        </div>
                        <small class="text-muted">Scheduled departures align with Mandi auction hours to preserve produce freshness.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="dash-card p-4 h-100">
            <h5 class="fw-bold mb-3">Technical Specifications</h5>
            <ul class="list-unstyled small mb-4">
                <li class="py-2 border-bottom d-flex justify-content-between">
                    <span class="text-muted">Backend Framework:</span>
                    <strong class="text-dark">ASP.NET Core 10 MVC</strong>
                </li>
                <li class="py-2 border-bottom d-flex justify-content-between">
                    <span class="text-muted">Database Engine:</span>
                    <strong class="text-dark">MS SQL Server</strong>
                </li>
                <li class="py-2 border-bottom d-flex justify-content-between">
                    <span class="text-muted">ORM:</span>
                    <strong class="text-dark">EF Core Code-First</strong>
                </li>
                <li class="py-2 border-bottom d-flex justify-content-between">
                    <span class="text-muted">Authentication:</span>
                    <strong class="text-dark">ASP.NET Core Identity</strong>
                </li>
                <li class="py-2 border-bottom d-flex justify-content-between">
                    <span class="text-muted">API Layer:</span>
                    <strong class="text-dark">RESTful Web API</strong>
                </li>
                <li class="py-2 d-flex justify-content-between">
                    <span class="text-muted">Course Code:</span>
                    <span class="badge bg-dark">INT402 Modern Web</span>
                </li>
            </ul>

            <div class="p-3 bg-light rounded-3 text-center border">
                <span class="badge bg-warning text-dark fw-bold mb-2">Hackathon Problem</span>
                <h6 class="fw-bold mb-1">Smart India Hackathon</h6>
                <p class="small text-muted mb-0">Statement Number: <strong>PR424</strong></p>
            </div>
        </div>
    </div>
</div>
