@using AgroTransport.Models
@{
    ViewData["Title"] = "Agricultural Transportation Sharing & Pooling — AgroTransport";
    ViewData["IsFullWidth"] = true;
    var featuredTrips = ViewBag.FeaturedTrips as List<TransportTrip> ?? new List<TransportTrip>();
}

<!-- ==========================================================================
     HERO SECTION — High Impact Split Layout with Interactive Pooling Card
     ========================================================================== -->
<section class="hero-wrapper">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <!-- Left Column: Value Proposition & CTAs -->
            <div class="col-lg-7">
                <div class="hero-badge-pill">
                    <i class="bi bi-patch-check-fill text-warning"></i>
                    <span>Smart India Hackathon PR424 • Modern Agricultural Logistics</span>
                </div>
                
                <h1 class="hero-headline">
                    Move Your Harvest.<br>
                    <span class="hero-gradient-text">Share The Journey.</span>
                </h1>
                
                <p class="hero-lead">
                    Connect with farmers and transporters, share vehicle capacity and get your agricultural produce to market at lower transportation costs.
                </p>
                
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Trips" asp-action="Search" class="btn-freight-primary">
                        <i class="bi bi-search"></i> Find Shared Transport
                    </a>
                    <a asp-controller="TransportRequests" asp-action="Create" class="btn-freight-secondary">
                        <i class="bi bi-plus-circle"></i> Post Produce Request
                    </a>
                </div>

                <!-- Trust Micro-Badges -->
                <div class="d-flex flex-wrap gap-4 pt-3 border-top border-secondary border-opacity-25 small text-white-50">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-6"></i>
                        <span>Zero Empty Return Runs</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-6"></i>
                        <span>Proportional Per-Kg Costing</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-6"></i>
                        <span>Direct Mandi Delivery</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Live Pooling Demonstration Card -->
            <div class="col-lg-5">
                <div class="dash-card p-4 text-start position-relative shadow-lg border border-secondary border-opacity-25 bg-dark text-white" style="border-radius: var(--at-radius-lg);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-diagram-3-fill me-1"></i> Live Pooling Concept
                        </span>
                        <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary">Phagwara &rarr; Delhi</span>
                    </div>

                    <div class="bg-black bg-opacity-40 p-3 rounded-3 mb-3 border border-secondary border-opacity-25">
                        <div class="d-flex justify-content-between small text-white-50 mb-1">
                            <span>Vehicle: <strong class="text-white">Eicher Pro 2049 (5,000 kg)</strong></span>
                            <span>Trip Cost: <strong class="text-white">₹10,000</strong></span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold text-white mb-2">
                            <span>Cost Rate:</span>
                            <span class="text-warning fs-6">₹2.00 per kg</span>
                        </div>
                        <div class="progress pooling-progress bg-secondary bg-opacity-25 mb-2" style="height: 8px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-white-50">
                            <span>2,500 kg Booked (50%)</span>
                            <span class="text-success fw-bold">2,500 kg Open Space</span>
                        </div>
                    </div>

                    <!-- Sharing Farmer Allocation List -->
                    <div class="small mb-3">
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                            <span><i class="bi bi-person-fill text-warning me-1"></i> Farmer A (1,000 kg Potatoes)</span>
                            <span class="fw-bold text-white">₹2,000</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                            <span><i class="bi bi-person-fill text-warning me-1"></i> Farmer B (1,500 kg Wheat)</span>
                            <span class="fw-bold text-white">₹3,000</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 text-white-50">
                            <span><i class="bi bi-plus-circle-dotted text-success me-1"></i> Space open for Farmer C</span>
                            <span class="text-success fw-bold">₹2 / kg</span>
                        </div>
                    </div>

                    <a asp-controller="Trips" asp-action="Search" class="btn btn-outline-warning btn-sm w-100 rounded-pill py-2 fw-semibold">
                        View Available Pooled Trips &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- Integrated Fast Route Finder Search Box -->
        <div class="hero-search-box">
            <form asp-controller="Trips" asp-action="Search" method="get" class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="search-field-label">
                        <i class="bi bi-geo-alt-fill text-warning"></i> Pickup Location / Village
                    </label>
                    <input type="text" name="source" class="search-field-input" placeholder="e.g. Phagwara, Jalandhar..." />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="search-field-label">
                        <i class="bi bi-pin-map-fill text-warning"></i> Destination Mandi
                    </label>
                    <input type="text" name="destination" class="search-field-input" placeholder="e.g. Azadpur Mandi, Khanna..." />
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="search-field-label">
                        <i class="bi bi-calendar-event text-warning"></i> Departure Date
                    </label>
                    <input type="date" name="departureDate" class="search-field-input" />
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="search-field-label">
                        <i class="bi bi-box-seam text-warning"></i> Crop Weight (kg)
                    </label>
                    <input type="number" name="minCapacity" class="search-field-input" placeholder="e.g. 500" min="50" step="50" />
                </div>
                <div class="col-lg-2 col-md-4">
                    <button type="submit" class="btn-freight-primary w-100 justify-content-center py-2">
                        <i class="bi bi-search"></i> Search Rides
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- ==========================================================================
     ACTIVE SCHEDULED TRIPS (Database-Driven Marketplace)
     ========================================================================== -->
<section class="py-5 bg-white">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="section-tag">Corridor Schedule</span>
                <h2 class="section-title mb-1">Available Scheduled Trips</h2>
                <p class="text-muted small mb-0">Book available load capacity on verified commercial vehicles travelling to wholesale Mandis.</p>
            </div>
            <a asp-controller="Trips" asp-action="Search" class="btn btn-outline-dark rounded-pill px-4 mt-3 mt-md-0 btn-sm">
                View All Trips &rarr;
            </a>
        </div>

        <div class="row g-4">
            @if (featuredTrips.Any())
            {
                @foreach (var trip in featuredTrips)
                {
                    var percentBooked = trip.TotalCapacityKg > 0 ? ((trip.TotalCapacityKg - trip.AvailableCapacityKg) / trip.TotalCapacityKg) * 100 : 0;
                    <div class="col-lg-4 col-md-6">
                        <div class="dash-card p-4 h-100 position-relative d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-warning bg-opacity-15 text-dark fw-bold px-2 py-1 small">
                                        <i class="bi bi-geo-alt-fill text-warning me-1"></i> @trip.SourceLocation &rarr; @trip.DestinationLocation
                                    </span>
                                    <span class="badge bg-success text-white px-2 py-1 rounded-pill small fw-bold">
                                        ₹@trip.CostPerKg.ToString("F2") / kg
                                    </span>
                                </div>
                                
                                <h5 class="fw-bold mb-1 text-dark">@trip.MandiName</h5>
                                <div class="small text-muted mb-3">
                                    <i class="bi bi-truck text-dark me-1"></i> @(trip.Vehicle?.RegistrationNumber ?? "Commercial Freight") &bull; @(trip.Vehicle?.VehicleType ?? "Truck")
                                </div>

                                <div class="p-2 bg-light rounded-3 small text-dark mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted"><i class="bi bi-calendar-check me-1"></i> Date:</span>
                                        <strong>@trip.DepartureDate.ToString("dd MMM yyyy")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted"><i class="bi bi-clock me-1"></i> Departure:</span>
                                        <strong>@trip.DepartureTime.ToString(@"hh\:mm")</strong>
                                    </div>
                                </div>

                                <div class="bg-light p-3 rounded-3 mb-3">
                                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                                        <span>Available Space:</span>
                                        <span class="text-success fw-bold">@trip.AvailableCapacityKg.ToString("N0") kg</span>
                                    </div>
                                    <div class="progress pooling-progress mb-1" style="height: 6px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @percentBooked%"></div>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted">
                                        <span>Total: @trip.TotalCapacityKg.ToString("N0") kg</span>
                                        <span>@percentBooked.ToString("N0")% Booked</span>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="bi bi-person-fill me-1"></i> @(trip.Transporter?.FullName ?? "Transporter")
                                </small>
                                <a asp-controller="Trips" asp-action="Details" asp-route-id="@trip.Id" class="btn btn-sm btn-dark rounded-pill px-3">
                                    Book Capacity &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="dash-card p-4 text-center">
                        <p class="text-muted mb-2">No upcoming scheduled trips found in the immediate schedule.</p>
                        <a asp-controller="Trips" asp-action="Search" class="btn btn-dark rounded-pill px-4 btn-sm">Search All Trips</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     CORE PLATFORM PILLARS (Clean 3-Card Value Summary)
     ========================================================================== -->
<section class="py-5 bg-light">
    <div class="container py-3">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="dash-card p-4 h-100">
                    <div class="dash-stat-icon orange mb-3" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Proportional Cost Sharing</h5>
                    <p class="small text-muted mb-0">
                        Farmers pay strictly for the weight occupied. By splitting total vehicle charter costs across pooled consignments, freight rates drop by up to 50%.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dash-card p-4 h-100">
                    <div class="dash-stat-icon emerald mb-3" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-truck-front-fill"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Zero Empty Return Trips</h5>
                    <p class="small text-muted mb-0">
                        Transporters publish outbound and return routes along major agricultural corridors, maximizing vehicle capacity utilization and earnings.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dash-card p-4 h-100">
                    <div class="dash-stat-icon navy mb-3" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Direct Mandi Market Timing</h5>
                    <p class="small text-muted mb-0">
                        Coordinated early morning departures guarantee produce arrives at agricultural wholesale markets in time for peak morning auctions.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
