@model AgroTransport.ViewModels.Trips.TripSearchViewModel
@{
    ViewData["Title"] = "Search Available Agricultural Transport — AgroTransport";
}

<div class="dash-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-truck-front-fill me-1"></i> Shared Freight Corridor
            </span>
            <h2 class="fw-bold mb-1">Find Shared Transportation</h2>
            <p class="text-white-50 mb-0">Search scheduled agricultural vehicles heading towards your destination wholesale Mandi and pool load space.</p>
        </div>
    </div>
</div>

<!-- Filter Card Form (Unit III QueryString Model Binding) -->
<div class="dash-card p-4 mb-4">
    <form asp-controller="Trips" asp-action="Search" method="get">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark">Source / Pickup City</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-geo-alt"></i></span>
                    <select name="source" class="form-select border-start-0">
                        <option value="">All Sources</option>
                        <option value="Phagwara" selected="@(Model.Source == "Phagwara")">Phagwara</option>
                        <option value="Jalandhar" selected="@(Model.Source == "Jalandhar")">Jalandhar</option>
                        <option value="Kapurthala" selected="@(Model.Source == "Kapurthala")">Kapurthala</option>
                        <option value="Ludhiana" selected="@(Model.Source == "Ludhiana")">Ludhiana</option>
                        <option value="Amritsar" selected="@(Model.Source == "Amritsar")">Amritsar</option>
                        <option value="Hoshiarpur" selected="@(Model.Source == "Hoshiarpur")">Hoshiarpur</option>
                        <option value="Goraya" selected="@(Model.Source == "Goraya")">Goraya</option>
                        <option value="Nakodar" selected="@(Model.Source == "Nakodar")">Nakodar</option>
                    </select>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark">Destination / District</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-geo"></i></span>
                    <select name="destination" class="form-select border-start-0">
                        <option value="">All Destinations</option>
                        <option value="Delhi" selected="@(Model.Destination == "Delhi")">Delhi</option>
                        <option value="Ludhiana" selected="@(Model.Destination == "Ludhiana")">Ludhiana</option>
                        <option value="Amritsar" selected="@(Model.Destination == "Amritsar")">Amritsar</option>
                        <option value="Jalandhar" selected="@(Model.Destination == "Jalandhar")">Jalandhar</option>
                        <option value="Chandigarh" selected="@(Model.Destination == "Chandigarh")">Chandigarh</option>
                        <option value="Karnal" selected="@(Model.Destination == "Karnal")">Karnal</option>
                        <option value="Ambala" selected="@(Model.Destination == "Ambala")">Ambala</option>
                    </select>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark">Target Mandi (Optional)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shop"></i></span>
                    <select name="mandi" class="form-select border-start-0">
                        <option value="">All Mandis</option>
                        <option value="Azadpur Mandi" selected="@(Model.Mandi == "Azadpur Mandi")">Azadpur Mandi (Delhi)</option>
                        <option value="Dana Mandi Ludhiana" selected="@(Model.Mandi == "Dana Mandi Ludhiana")">Dana Mandi Ludhiana</option>
                        <option value="Bhagtanwala Grain Mandi" selected="@(Model.Mandi == "Bhagtanwala Grain Mandi")">Bhagtanwala Grain Mandi (Amritsar)</option>
                        <option value="Khanna" selected="@(Model.Mandi == "Khanna")">Khanna Grain Market</option>
                        <option value="New Grain Market Jalandhar" selected="@(Model.Mandi == "New Grain Market Jalandhar")">New Grain Market Jalandhar</option>
                        <option value="Karnal APMC Mandi" selected="@(Model.Mandi == "Karnal APMC Mandi")">Karnal APMC Mandi</option>
                    </select>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark">Departure Date</label>
                <input type="date" name="departureDate" value="@(Model.DepartureDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark">Vehicle Type</label>
                <select name="vehicleType" asp-for="VehicleType" asp-items="Model.VehicleTypeList" class="form-select"></select>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark">Minimum Load Space Needed (kg)</label>
                <input type="number" name="minCapacity" value="@Model.MinCapacity" step="50" min="0" class="form-control" placeholder="e.g. 500 kg" />
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <span class="text-muted small">
                Showing <strong>@Model.Trips.Count</strong> active trip(s) matching your parameters
            </span>
            <div class="d-flex gap-2">
                <a asp-action="Search" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">Clear Filters</a>
                <button type="submit" class="btn-freight-primary py-2 px-4 btn-sm">
                    <i class="bi bi-search"></i> Apply Filters
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Results Grid -->
<div class="row g-4">
    @if (!Model.Trips.Any())
    {
        <div class="col-12">
            <div class="dash-card p-5 text-center">
                <i class="bi bi-truck text-muted fs-1 mb-3 d-block"></i>
                <h4 class="fw-bold text-dark">No Scheduled Trips Found</h4>
                <p class="text-muted small max-w-500 mx-auto mb-4">
                    There are currently no active transport trips matching your exact search filters. Try broadening your dates or posting a customized produce transportation request.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Search" class="btn btn-outline-dark rounded-pill px-3">Show All Trips</a>
                    <a asp-controller="TransportRequests" asp-action="Create" class="btn-freight-primary px-3">
                        <i class="bi bi-plus-circle"></i> Post Market Request
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var trip in Model.Trips)
        {
            var percentBooked = trip.TotalCapacityKg > 0 ? ((trip.TotalCapacityKg - trip.AvailableCapacityKg) / trip.TotalCapacityKg) * 100 : 0;
            <div class="col-md-6 col-lg-4">
                <div class="dash-card p-4 h-100 d-flex flex-column justify-content-between position-relative">
                    <div>
                        <!-- Header Pill -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-warning bg-opacity-15 text-dark fw-bold px-2 py-1 small">
                                <i class="bi bi-geo-alt-fill text-warning me-1"></i> @trip.SourceLocation &rarr; @trip.DestinationLocation
                            </span>
                            <span class="badge bg-success text-white px-2 py-1 rounded-pill small fw-bold">
                                ₹@trip.CostPerKg.ToString("F2") / kg
                            </span>
                        </div>

                        <h5 class="fw-bold mb-1 text-dark">@trip.MandiName</h5>
                        <div class="small text-muted mb-3">
                            <i class="bi bi-truck text-dark me-1"></i> @(trip.Vehicle?.VehicleType ?? "Commercial Vehicle") &bull; @(trip.Vehicle?.RegistrationNumber ?? "N/A")
                        </div>

                        <!-- Date & Time -->
                        <div class="p-2 bg-light rounded-3 small text-dark mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted"><i class="bi bi-calendar-check me-1"></i> Date:</span>
                                <strong>@trip.DepartureDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-clock me-1"></i> Departure:</span>
                                <strong>@trip.DepartureTime.ToString(@"hh\:mm")</strong>
                            </div>
                        </div>

                        <!-- Capacity Bar -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">Available Space:</span>
                                <strong class="text-success">@trip.AvailableCapacityKg.ToString("N0") kg</strong>
                            </div>
                            <div class="progress pooling-progress mb-1">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @percentBooked%"></div>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Total: @trip.TotalCapacityKg.ToString("N0") kg</span>
                                <span>@percentBooked.ToString("N0")% Booked</span>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="bi bi-person-fill me-1"></i> @(trip.Transporter?.FullName ?? "Verified Transporter")
                        </small>
                        <a asp-action="Details" asp-route-id="@trip.Id" class="btn btn-sm btn-dark rounded-pill px-3">
                            Details &rarr;
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
