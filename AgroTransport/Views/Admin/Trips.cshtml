@model List<AgroTransport.Models.TransportTrip>
@{
    ViewData["Title"] = "All Transportation Trips";
}

<div class="py-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <a asp-controller="Admin" asp-action="Index" class="text-muted small text-decoration-none">&larr; Back to Admin Console</a>
            <h2 class="fw-bold text-dark mt-1 mb-0">Platform Trips Management</h2>
            <p class="text-muted small mb-0">Audit all published agricultural trips across the platform.</p>
        </div>
    </div>

    <div class="card card-agro p-4 border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Transporter</th>
                        <th>Route & Mandi</th>
                        <th>Vehicle & Reg</th>
                        <th>Departure</th>
                        <th>Capacity (Booked/Total)</th>
                        <th>Trip Fare</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        decimal booked = t.TotalCapacityKg - t.AvailableCapacityKg;
                        <tr>
                            <td><strong class="badge bg-light text-dark border">#@t.Id</strong></td>
                            <td>
                                <strong class="text-dark d-block">@t.Transporter?.FullName</strong>
                                <small class="text-muted">@t.Transporter?.Email</small>
                            </td>
                            <td>
                                <strong>@t.SourceLocation &rarr; @t.DestinationLocation</strong>
                                <small class="d-block text-muted">@t.MandiName</small>
                            </td>
                            <td>
                                <span>@t.Vehicle?.Model</span>
                                <small class="d-block text-muted">@t.Vehicle?.RegistrationNumber</small>
                            </td>
                            <td>@t.DepartureDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span>@booked.ToString("N0") / @t.TotalCapacityKg.ToString("N0") kg</span>
                                <small class="d-block text-success">Avail: @t.AvailableCapacityKg.ToString("N0") kg</small>
                            </td>
                            <td><strong>₹@t.TotalCost.ToString("N0")</strong></td>
                            <td><span class="badge @(t.TripStatus == "Scheduled" ? "bg-success" : "bg-secondary")">@t.TripStatus</span></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Trips" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1">
                                        View
                                    </a>
                                    <form asp-controller="Admin" asp-action="DeleteTrip" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tripId" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" onclick="return confirm('Remove trip #@t.Id? Cannot remove if accepted bookings exist.')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

