@model AgroTransport.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Platform Administration Console";
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-danger px-3 py-1 rounded-pill mb-1">Feature 10 &ndash; Administrator Console</span>
            <h2 class="fw-bold text-dark mb-0">AgroTransport System Operations</h2>
            <p class="text-muted small mb-0">Monitor agricultural freight pooling transactions, audit registered users, and inspect platform metrics</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-people me-1"></i> Manage Users
            </a>
            <a asp-controller="Admin" asp-action="Trips" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-truck me-1"></i> Manage Trips
            </a>
            <a asp-controller="Admin" asp-action="Bookings" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bi bi-journal-text me-1"></i> All Bookings
            </a>
        </div>
    </div>

    <!-- 8 Key Metrics Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Registered Farmers</span>
                        <h3 class="fw-bold text-success mb-0">@Model.TotalFarmers</h3>
                    </div>
                    <div class="stat-card-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-person-heart"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Transporters</span>
                        <h3 class="fw-bold text-primary mb-0">@Model.TotalTransporters</h3>
                    </div>
                    <div class="stat-card-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Active Vehicles</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalVehicles</h3>
                    </div>
                    <div class="stat-card-icon bg-secondary bg-opacity-10 text-dark">
                        <i class="bi bi-car-front"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Total Trips</span>
                        <h3 class="fw-bold text-info mb-0">@Model.TotalTrips</h3>
                    </div>
                    <div class="stat-card-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Total Bookings</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalBookings</h3>
                    </div>
                    <div class="stat-card-icon bg-dark bg-opacity-10 text-dark">
                        <i class="bi bi-journal-check"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Pending Bookings</span>
                        <h3 class="fw-bold text-warning mb-0">@Model.PendingBookings</h3>
                    </div>
                    <div class="stat-card-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Produce Pooled</span>
                        <h3 class="fw-bold text-success mb-0">@Model.TotalPlatformVolumeKg.ToString("N0") kg</h3>
                    </div>
                    <div class="stat-card-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Platform Value</span>
                        <h3 class="fw-bold text-primary mb-0">₹@Model.TotalEconomicValue.ToString("N0")</h3>
                    </div>
                    <div class="stat-card-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- Tables: Recent Users & Recent Bookings -->
    <div class="row g-4">
        <!-- Recent Users -->
        <div class="col-lg-6">
            <div class="card card-agro p-4 border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Recent User Registrations</h5>
                    <a asp-controller="Admin" asp-action="Users" class="small text-success text-decoration-none">View All &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Name & Email</th>
                                <th>Role</th>
                                <th>Location</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark d-block">@user.FullName</strong>
                                        <small class="text-muted">@user.Email</small>
                                    </td>
                                    <td>
                                        <span class="badge @(user.UserRole == "Farmer" ? "bg-success" : user.UserRole == "Transporter" ? "bg-primary" : "bg-danger")">
                                            @user.UserRole
                                        </span>
                                    </td>
                                    <td>@user.Village, @user.District</td>
                                    <td>
                                        <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                            @(user.IsActive ? "Active" : "Deactivated")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Bookings -->
        <div class="col-lg-6">
            <div class="card card-agro p-4 border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Recent Platform Bookings</h5>
                    <a asp-controller="Admin" asp-action="Bookings" class="small text-success text-decoration-none">View All &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Farmer</th>
                                <th>Produce & Weight</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.RecentBookings)
                            {
                                <tr>
                                    <td><strong class="text-dark">@b.BookingReference</strong></td>
                                    <td>@b.Farmer?.FullName</td>
                                    <td>@b.ProduceType (@b.RequestedQuantityKg.ToString("N0") kg)</td>
                                    <td><strong class="text-success">₹@b.TotalCost.ToString("N0")</strong></td>
                                    <td>
                                        <span class="badge @(b.Status == "Accepted" ? "bg-success" : b.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                                            @b.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



