@model AgroTransport.ViewModels.Transporter.TransporterDashboardViewModel
@{
    ViewData["Title"] = "Transporter Dashboard";
}

<div class="py-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                Transporter Control Hub &ndash; @Model.TransporterName 🚚
            </h2>
            <p class="text-muted small mb-0">
                Manage commercial fleet, schedule trips to Mandis, and approve farmer pooling requests
            </p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Trips" asp-action="Create" class="btn btn-agro-primary btn-sm px-3 rounded-pill shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Publish New Trip
            </a>
            <a asp-controller="Vehicles" asp-action="Create" class="btn btn-outline-primary btn-sm px-3 rounded-pill bg-white">
                <i class="bi bi-truck me-1"></i> Add Vehicle
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Fleet Vehicles</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalVehicles</h3>
                    </div>
                    <div class="stat-card-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Scheduled Trips</span>
                        <h3 class="fw-bold text-success mb-0">@Model.ActiveTrips</h3>
                    </div>
                    <div class="stat-card-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Pending Bookings</span>
                        <h3 class="fw-bold text-warning mb-0">@Model.PendingRequestsCount</h3>
                    </div>
                    <div class="stat-card-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Confirmed Revenue</span>
                        <h3 class="fw-bold text-primary mb-0">₹@Model.TotalEarnings.ToString("N0")</h3>
                    </div>
                    <div class="stat-card-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Urgent Section: Pending Farmer Requests to Review -->
    @if (Model.PendingBookings.Any())
    {
        <div class="card card-agro p-4 border-warning mb-4 shadow-sm" style="border-left: 5px solid #f59e0b !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-exclamation-circle-fill text-warning me-1"></i> Action Required: Pending Farmer Bookings
                    </h5>
                    <small class="text-muted">Farmers have requested to pool produce in your trips. Review and accept to allocate capacity.</small>
                </div>
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@Model.PendingBookings.Count Waiting</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Farmer</th>
                            <th>Trip Route</th>
                            <th>Produce</th>
                            <th>Quantity</th>
                            <th>Fare</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var booking in Model.PendingBookings)
                        {
                            <tr>
                                <td>
                                    <strong class="d-block text-dark">@booking.Farmer?.FullName</strong>
                                    <small class="text-muted">@booking.Farmer?.PhoneNumber &bull; @booking.Farmer?.Village</small>
                                </td>
                                <td>
                                    <strong>@booking.Trip?.SourceLocation &rarr; @booking.Trip?.DestinationLocation</strong>
                                    <small class="d-block text-muted">@booking.Trip?.DepartureDate.ToString("dd MMM") (Avail: @booking.Trip?.AvailableCapacityKg.ToString("N0") kg)</small>
                                </td>
                                <td>@booking.ProduceType</td>
                                <td><strong>@booking.RequestedQuantityKg.ToString("N0")</strong> kg</td>
                                <td><strong class="text-success">₹@booking.TotalCost.ToString("N0")</strong></td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <!-- One-click Accept Form -->
                                        <form asp-controller="Bookings" asp-action="Accept" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@booking.Id" />
                                            <input type="hidden" name="returnUrl" value="/Transporter" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" onclick="return confirm('Accept this booking and allocate @booking.RequestedQuantityKg kg vehicle capacity?')">
                                                <i class="bi bi-check-lg"></i> Accept
                                            </button>
                                        </form>

                                        <!-- One-click Reject Form -->
                                        <form asp-controller="Bookings" asp-action="Reject" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@booking.Id" />
                                            <input type="hidden" name="returnUrl" value="/Transporter" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Reject this booking request?')">
                                                <i class="bi bi-x-lg"></i> Decline
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Main Grid: Published Trips & Registered Vehicles -->
    <div class="row g-4 mb-4">
        <!-- Published Trips Table -->
        <div class="col-lg-8">
            <div class="card card-agro p-4 border-0 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-calendar3 me-1 text-primary"></i> My Published Transportation Trips
                    </h5>
                    <a asp-controller="Trips" asp-action="Create" class="btn btn-sm btn-agro-primary rounded-pill px-3">
                        + New Trip
                    </a>
                </div>

                @if (Model.Trips.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Route & Date</th>
                                    <th>Vehicle</th>
                                    <th>Capacity Usage</th>
                                    <th>Total Cost</th>
                                    <th>Status</th>
                                    <th>Manage</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var trip in Model.Trips)
                                {
                                    decimal booked = trip.TotalCapacityKg - trip.AvailableCapacityKg;
                                    decimal pct = trip.TotalCapacityKg > 0 ? (booked / trip.TotalCapacityKg) * 100 : 0;
                                    var badgeCls = trip.TripStatus == "Scheduled" ? "badge-status-scheduled" :
                                                   trip.TripStatus == "Completed" ? "badge-status-completed" : "badge-status-cancelled";
                                    <tr>
                                        <td>
                                            <strong class="d-block text-dark">@trip.SourceLocation &rarr; @trip.DestinationLocation</strong>
                                            <small class="text-muted">@trip.DepartureDate.ToString("dd MMM yyyy") at @trip.DepartureTime.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td>
                                            <span>@trip.Vehicle?.Model</span>
                                            <small class="d-block text-muted">@trip.Vehicle?.RegistrationNumber</small>
                                        </td>
                                        <td style="min-width: 140px;">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span>@booked.ToString("N0") / @trip.TotalCapacityKg.ToString("N0") kg</span>
                                                <span class="text-success fw-bold">@pct.ToString("F0")%</span>
                                            </div>
                                            <div class="progress pooling-progress">
                                                <div class="progress-bar bg-success" style="width: @pct%"></div>
                                            </div>
                                        </td>
                                        <td><strong>₹@trip.TotalCost.ToString("N0")</strong></td>
                                        <td><span class="badge @badgeCls">@trip.TripStatus</span></td>
                                        <td>
                                            <a asp-controller="Transporter" asp-action="TripBookings" asp-route-id="@trip.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1">
                                                Pool Roster (@trip.Bookings.Count)
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2 text-muted"></i>
                        <p class="mb-2">No trips published yet.</p>
                        <a asp-controller="Trips" asp-action="Create" class="btn btn-agro-primary btn-sm rounded-pill px-3">
                            Publish Your First Trip
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Registered Vehicles Column -->
        <div class="col-lg-4">
            <div class="card card-agro p-4 border-0 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-truck text-success me-1"></i> My Vehicle Fleet
                    </h6>
                    <a asp-controller="Vehicles" asp-action="Index" class="small text-primary text-decoration-none">
                        Manage All
                    </a>
                </div>

                @if (Model.Vehicles.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var v in Model.Vehicles)
                        {
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark">@v.RegistrationNumber</strong>
                                    <span class="badge @(v.Status == "Active" ? "bg-success" : "bg-secondary")">@v.Status</span>
                                </div>
                                <div class="small text-muted">@v.Model (@v.VehicleType)</div>
                                <div class="small text-success fw-bold mt-1">Capacity: @v.CapacityKg.ToString("N0") kg</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <p class="mb-2">No vehicles registered yet.</p>
                        <a asp-controller="Vehicles" asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill w-100">
                            + Register Vehicle
                        </a>
                    </div>
                }
            </div>

            <!-- Open Market Requests -->
            <div class="card card-agro p-4 border-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-broadcast text-warning me-1"></i> Farmers Looking for Transport
                    </h6>
                    <a asp-controller="TransportRequests" asp-action="Index" class="small text-success text-decoration-none">
                        Marketplace
                    </a>
                </div>
                @if (Model.OpenMarketRequests.Any())
                {
                    <div class="d-flex flex-column gap-2 small">
                        @foreach (var r in Model.OpenMarketRequests)
                        {
                            <div class="p-2 border rounded-2 bg-light">
                                <div class="fw-bold text-dark">@r.ProduceType &bull; @r.RequiredCapacityKg.ToString("N0") kg</div>
                                <div class="text-muted small">@r.PickupLocation &rarr; @r.DestinationLocation</div>
                                <div class="d-flex justify-content-between mt-1 text-muted">
                                    <span>Date: @r.PreferredDate.ToString("dd MMM")</span>
                                    <a asp-controller="Trips" asp-action="Create" class="text-success fw-bold text-decoration-none">Schedule &rarr;</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center mb-0 py-2">No open farmer requests currently.</p>
                }
            </div>
        </div>
    </div>
</div>

