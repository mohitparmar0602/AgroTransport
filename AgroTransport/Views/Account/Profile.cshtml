@model AgroTransport.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-7">
        <div class="card card-agro border-0 shadow-sm p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="user-avatar-circle" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    @(Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">@Model.FullName</h4>
                    <span class="badge bg-success">@Model.UserRole</span>
                    <span class="text-muted small ms-2">@Model.Email</span>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Village" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="Village" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="District" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="District" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label fw-semibold small text-dark"></label>
                        <input asp-for="State" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label fw-semibold small text-dark"></label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-agro-primary px-4 py-2 rounded-pill fw-bold">
                    <i class="bi bi-save me-1"></i> Save Profile Changes
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

