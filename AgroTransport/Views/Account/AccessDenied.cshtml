@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card card-agro border-0 shadow-sm p-5">
            <div class="display-1 text-warning mb-3">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required role permissions to access this administrative or role-restricted page. Role-based access control enforces that farmers and transporters operate only within authorized areas.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-agro-primary px-4 py-2 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Return to Safety
                </a>
            </div>
        </div>
    </div>
</div>

