@model List<AgroTransport.Models.Vehicle>
@{
    ViewData["Title"] = "Vehicle Fleet Management";
}

<div class="py-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Commercial Vehicle Fleet</h2>
            <p class="text-muted small mb-0">Feature 3 &ndash; Vehicle Management: Register freight carriers, specify load capacities, and manage maintenance states.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Vehicles" asp-action="Create" class="btn btn-agro-primary btn-sm rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add New Vehicle
            </a>
        </div>
    </div>

    <div class="card card-agro p-4 border-0 shadow-sm">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Registration Number</th>
                            <th>Vehicle Model</th>
                            <th>Category / Type</th>
                            <th>Load Capacity</th>
                            <th>Status</th>
                            <th>Trips Run</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            var badgeClass = v.Status == "Active" ? "bg-success" : v.Status == "Maintenance" ? "bg-warning text-dark" : "bg-secondary";
                            <tr>
                                <td><strong class="text-dark fs-6">@v.RegistrationNumber</strong></td>
                                <td>@v.Model</td>
                                <td><span class="badge bg-light text-dark border">@v.VehicleType</span></td>
                                <td><strong class="text-success fs-6">@v.CapacityKg.ToString("N0")</strong> kg</td>
                                <td><span class="badge @badgeClass">@v.Status</span></td>
                                <td>@v.Trips.Count Trips</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Vehicles" asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-controller="Vehicles" asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" onclick="return confirm('Delete this vehicle? It can only be deleted if not assigned to active trips.')">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-truck fs-1 d-block mb-2"></i>
                <h5 class="fw-bold text-dark">No Vehicles Registered</h5>
                <p class="mb-3">You must register at least one vehicle before you can publish transportation trips.</p>
                <a asp-controller="Vehicles" asp-action="Create" class="btn btn-agro-primary rounded-pill px-4">
                    Register Your First Vehicle
                </a>
            </div>
        }
    </div>
</div>

