@model AgroTransport.ViewModels.Vehicles.VehicleFormViewModel
@{
    ViewData["Title"] = "Register Vehicle";
}

<div class="row justify-content-center py-2">
    <div class="col-md-8 col-lg-7">
        <div class="card card-agro p-4 p-md-5 border-0 shadow-sm">
            <div class="mb-4">
                <a asp-controller="Vehicles" asp-action="Index" class="text-muted small text-decoration-none">
                    &larr; Back to Vehicles List
                </a>
                <h3 class="fw-bold text-dark mt-2 mb-1">Register New Vehicle</h3>
                <p class="text-muted small mb-0">
                    Add a cargo vehicle to your fleet with accurate verified payload weight capacity.
                </p>
            </div>

            <form asp-controller="Vehicles" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3"></div>

                <div class="mb-3">
                    <label asp-for="RegistrationNumber" class="form-label fw-semibold small text-dark"></label>
                    <input asp-for="RegistrationNumber" class="form-control text-uppercase" placeholder="e.g. PB-10-DX-9901" />
                    <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                    <small class="text-muted">Enter official state transport vehicle registration plate number.</small>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="VehicleType" class="form-label fw-semibold small text-dark"></label>
                        <select asp-for="VehicleType" asp-items="Model.VehicleTypes" class="form-select"></select>
                        <span asp-validation-for="VehicleType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CapacityKg" class="form-label fw-semibold small text-dark"></label>
                        <div class="input-group">
                            <input asp-for="CapacityKg" class="form-control" placeholder="e.g. 5000" />
                            <span class="input-group-text bg-light text-muted">kg</span>
                        </div>
                        <span asp-validation-for="CapacityKg" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label fw-semibold small text-dark"></label>
                    <input asp-for="Model" class="form-control" placeholder="e.g. Eicher Pro 2049, Tata 407, Mahindra Bolero" />
                    <span asp-validation-for="Model" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label fw-semibold small text-dark"></label>
                    <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Vehicles" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-agro-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                        Register Vehicle <i class="bi bi-check2 ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

