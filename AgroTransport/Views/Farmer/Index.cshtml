@model AgroTransport.ViewModels.Farmer.FarmerDashboardViewModel
@{
    ViewData["Title"] = "Farmer Dashboard";
}

<div class="py-2">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                Kisan Portal &ndash; Welcome, @Model.FarmerName! 👋
            </h2>
            <p class="text-muted small mb-0">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Base Village: <strong>@Model.Location</strong> &bull; Share freight capacity & reduce transit costs
            </p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Trips" asp-action="Search" class="btn btn-agro-primary btn-sm px-3 rounded-pill shadow-sm">
                <i class="bi bi-search me-1"></i> Find Transport
            </a>
            <a asp-controller="TransportRequests" asp-action="Create" class="btn btn-outline-success btn-sm px-3 rounded-pill bg-white">
                <i class="bi bi-plus-circle me-1"></i> Post Market Request
            </a>
        </div>
    </div>

    <!-- Quick Action Cards (Feature 2) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <a asp-controller="Trips" asp-action="Search" class="card card-agro p-3 quick-action-card text-center h-100">
                <i class="bi bi-search text-success fs-3 mb-1"></i>
                <strong class="d-block text-dark small">1. Find Transport</strong>
                <small class="text-muted" style="font-size: 0.7rem;">Filter trips by route</small>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="Trips" asp-action="Search" class="card card-agro p-3 quick-action-card text-center h-100">
                <i class="bi bi-diagram-3-fill text-primary fs-3 mb-1"></i>
                <strong class="d-block text-dark small">2. Join Shared Trip</strong>
                <small class="text-muted" style="font-size: 0.7rem;">Pool load in active trip</small>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="TransportRequests" asp-action="Create" class="card card-agro p-3 quick-action-card text-center h-100">
                <i class="bi bi-broadcast text-warning fs-3 mb-1"></i>
                <strong class="d-block text-dark small">3. Create Request</strong>
                <small class="text-muted" style="font-size: 0.7rem;">Post custom need</small>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="Bookings" asp-action="MyBookings" class="card card-agro p-3 quick-action-card text-center h-100">
                <i class="bi bi-journal-check text-info fs-3 mb-1"></i>
                <strong class="d-block text-dark small">4. My Bookings</strong>
                <small class="text-muted" style="font-size: 0.7rem;">Manage reservations</small>
            </a>
        </div>
        <div class="col-6 col-md">
            <a asp-controller="Account" asp-action="Profile" class="card card-agro p-3 quick-action-card text-center h-100">
                <i class="bi bi-person-gear text-secondary fs-3 mb-1"></i>
                <strong class="d-block text-dark small">5. My Profile</strong>
                <small class="text-muted" style="font-size: 0.7rem;">Update farm info</small>
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Active Bookings</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.ActiveBookings</h3>
                    </div>
                    <div class="stat-card-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Pending Approval</span>
                        <h3 class="fw-bold text-warning mb-0">@Model.PendingBookings</h3>
                    </div>
                    <div class="stat-card-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Completed Trips</span>
                        <h3 class="fw-bold text-secondary mb-0">@Model.CompletedBookings</h3>
                    </div>
                    <div class="stat-card-icon bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-check2-all"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-agro p-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Estimated Savings</span>
                        <h3 class="fw-bold text-success mb-0">₹@Model.TotalEstimatedSavings.ToString("N0")</h3>
                    </div>
                    <div class="stat-card-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-piggy-bank"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content: Recent Bookings & Notifications -->
    <div class="row g-4 mb-4">
        <!-- Recent Bookings Table -->
        <div class="col-lg-8">
            <div class="card card-agro p-4 border-0 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-clock-history me-1 text-success"></i> Recent Booking Activities
                    </h5>
                    <a asp-controller="Bookings" asp-action="MyBookings" class="text-success small fw-semibold text-decoration-none">
                        View All Bookings &rarr;
                    </a>
                </div>

                @if (Model.RecentBookings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Ref / Produce</th>
                                    <th>Route & Mandi</th>
                                    <th>Load (kg)</th>
                                    <th>Pooled Share</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var b in Model.RecentBookings)
                                {
                                    var badgeCls = b.Status == "Accepted" ? "badge-status-accepted" :
                                                   b.Status == "Pending" ? "badge-status-pending" :
                                                   b.Status == "Completed" ? "badge-status-completed" : "badge-status-cancelled";
                                    <tr>
                                        <td>
                                            <strong class="d-block text-dark">@b.BookingReference</strong>
                                            <span class="text-muted">@b.ProduceType</span>
                                        </td>
                                        <td>
                                            <span class="d-block">@b.Trip?.SourceLocation &rarr; @b.Trip?.DestinationLocation</span>
                                            <small class="text-muted">@b.Trip?.MandiName</small>
                                        </td>
                                        <td><strong>@b.RequestedQuantityKg.ToString("N0")</strong> kg</td>
                                        <td><strong class="text-success">₹@b.TotalCost.ToString("N0")</strong></td>
                                        <td>
                                            <span class="badge @badgeCls">@b.Status</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-success rounded-pill py-1 px-2">
                                                Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                        <p class="mb-2">You haven't made any transportation bookings yet.</p>
                        <a asp-controller="Trips" asp-action="Search" class="btn btn-agro-primary btn-sm rounded-pill px-3">
                            Find Available Trips
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Notifications & Open Requests -->
        <div class="col-lg-4">
            <!-- Notifications Card -->
            <div class="card card-agro p-4 border-0 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-bell-fill text-warning me-1"></i> Notifications
                    </h6>
                    <a asp-controller="Notifications" asp-action="Index" class="small text-muted text-decoration-none">
                        View All
                    </a>
                </div>
                @if (Model.RecentNotifications.Any())
                {
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @foreach (var n in Model.RecentNotifications)
                        {
                            <li class="p-2 rounded-2 @(n.IsRead ? "bg-light" : "bg-success bg-opacity-10 border border-success border-opacity-25")">
                                <div class="fw-semibold text-dark">@n.Title</div>
                                <div class="text-muted small text-truncate">@n.Message</div>
                                <small class="text-muted" style="font-size: 0.65rem;">@n.CreatedAt.ToString("g")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0 text-center py-3">No notifications at this time.</p>
                }
            </div>

            <!-- Farmer's Broadcast Requests -->
            <div class="card card-agro p-4 border-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-broadcast text-primary me-1"></i> My Market Requests
                    </h6>
                    <a asp-controller="TransportRequests" asp-action="MyRequests" class="small text-success text-decoration-none">
                        Manage
                    </a>
                </div>
                @if (Model.MyRequests.Any())
                {
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @foreach (var req in Model.MyRequests)
                        {
                            <li class="p-2 border rounded-2 bg-light">
                                <div class="d-flex justify-content-between">
                                    <strong class="text-dark">@req.ProduceType</strong>
                                    <span class="badge bg-secondary">@req.Status</span>
                                </div>
                                <div class="text-muted small">@req.RequiredCapacityKg.ToString("N0") kg &bull; @req.DestinationLocation</div>
                                <small class="text-muted">Need by: @req.PreferredDate.ToString("dd MMM yyyy")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-2 text-center">No active requests posted.</p>
                    <a asp-controller="TransportRequests" asp-action="Create" class="btn btn-outline-success btn-sm w-100 rounded-pill">
                        + Post Request
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Available Transport Trips Row -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-truck text-success me-1"></i> Available Trips Heading to Mandis
            </h5>
            <a asp-controller="Trips" asp-action="Search" class="btn btn-outline-success btn-sm rounded-pill px-3">
                Search with Filters &rarr;
            </a>
        </div>

        <div class="row g-3">
            @foreach (var trip in Model.AvailableTrips)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card trip-card h-100 shadow-sm border-0 d-flex flex-column">
                        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                            <span class="badge bg-agro-primary text-white">@trip.Vehicle?.VehicleType</span>
                            <span class="badge bg-white text-dark border">₹@trip.CostPerKg.ToString("F2")/kg</span>
                        </div>
                        <div class="p-3 flex-grow-1">
                            <strong class="d-block text-dark mb-1">@trip.SourceLocation &rarr; @trip.DestinationLocation</strong>
                            <div class="small text-muted mb-2"><i class="bi bi-shop text-success"></i> @trip.MandiName</div>
                            <div class="small text-muted mb-3">
                                <div>Date: <strong>@trip.DepartureDate.ToString("dd MMM yyyy")</strong></div>
                                <div>Available: <strong class="text-success">@trip.AvailableCapacityKg.ToString("N0") kg</strong></div>
                            </div>
                        </div>
                        <div class="p-3 bg-light border-top">
                            <a asp-controller="Trips" asp-action="Details" asp-route-id="@trip.Id" class="btn btn-agro-primary btn-sm w-100 rounded-pill">
                                Join Trip &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

